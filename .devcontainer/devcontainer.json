{
  "name": "provenance-guard",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "hostRequirements": {
    "cpus": 2
  },
  "postCreateCommand": "pip install --user uv && npm install -g @anthropic-ai/claude-code",
  "forwardPorts": [
    8000
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "ms-python.python",
        "charliermarsh.ruff"
      ]
    }
  }
}
