# Copy to .env for local runs. In Codespaces, set these as Codespaces secrets instead (never commit .env).
# LLM providers (all free tiers; see config/providers.yaml). Leave unset to run in replay/cassette mode.
GROQ_API_KEY=
GEMINI_API_KEY=
# Local services (docker compose defaults)
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql+asyncpg://provguard:provguard@localhost:5432/provguard
QDRANT_URL=http://localhost:6333
# Observability (Phase 6). Langfuse Cloud free tier keys, if used.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
